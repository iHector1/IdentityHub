{
  "info": {
    "_postman_id": "b7d1d92c-8d5f-4f9e-b6dd-identityhub",
    "name": "IdentityHub API",
    "description": "Coleccion para probar UserService y AuthService.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "userServiceUrl",
      "value": "http://localhost:5094"
    },
    {
      "key": "authServiceUrl",
      "value": "http://localhost:5029"
    },
    {
      "key": "userId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "userEmail",
      "value": "juan.perez@example.com"
    },
    {
      "key": "password",
      "value": "Password123"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "UserService",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/users",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Crea un usuario. Guarda automaticamente su id en la variable userId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const user = pm.response.json();",
                  "    pm.collectionVariables.set('userId', user.id);",
                  "    pm.collectionVariables.set('userEmail', user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/api/users",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "Obtener usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/{{userId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan Carlos\",\n  \"lastName\": \"Perez\",\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/users/{{userId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/{{userId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "AuthService",
      "item": [
        {
          "name": "Registrar credenciales",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{authServiceUrl}}/api/auth/register",
              "host": [
                "{{authServiceUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Requiere ejecutar primero Crear usuario."
          }
        },
        {
          "name": "Registro - usuario inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"00000000-0000-0000-0000-000000000001\",\n  \"email\": \"usuario@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{authServiceUrl}}/api/auth/register",
              "host": [
                "{{authServiceUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Registro - email incorrecto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"email\": \"otro@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{authServiceUrl}}/api/auth/register",
              "host": [
                "{{authServiceUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{authServiceUrl}}/api/auth/login",
              "host": [
                "{{authServiceUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const auth = pm.response.json();",
                  "    pm.collectionVariables.set('token', auth.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{authServiceUrl}}/api/auth/me",
              "host": [
                "{{authServiceUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Ejecutar despues de Login."
          }
        }
      ]
    }
  ]
}
